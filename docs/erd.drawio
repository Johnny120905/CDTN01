        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Cấu hình giao diện chuẩn ERD, bỏ vòng tròn mặc định, đi nét vuông góc\nhide circle\nskinparam linetype ortho\nskinparam class {\n    BackgroundColor White\n    BorderColor Black\n    ArrowColor Black\n}\n\n&#39; 1. Thực thể service_center\nentity \&quot;service_center\&quot; as sc {\n  * center_id : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  * center_name : VARCHAR(100)\n}\n\n&#39; 2. Thực thể part\nentity \&quot;part\&quot; as p {\n  * part_code : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  * part_name : VARCHAR(120)\n  * price : DECIMAL(12,2)\n  * min_threshold : INT\n}\n\n&#39; 3. Thực thể ticket\nentity \&quot;ticket\&quot; as t {\n  * ticket_id : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  * status : VARCHAR(20)\n}\n\n&#39; 4. Thực thể part_stock (Khóa chính phức hợp kết hợp khóa ngoại)\nentity \&quot;part_stock\&quot; as ps {\n  * center_id : VARCHAR(20) &lt;&lt;PK, FK&gt;&gt;\n  * part_code : VARCHAR(20) &lt;&lt;PK, FK&gt;&gt;\n  --\n  * quantity : INT\n}\n\n&#39; 5. Thực thể part_transaction\nentity \&quot;part_transaction\&quot; as ptr {\n  * transaction_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  * center_id : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  * part_code : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  ticket_id : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  * type : VARCHAR(10)\n  * quantity : INT\n  * created_by : VARCHAR(50)\n  * created_at : TIMESTAMPTZ\n}\n\n&#39; ==========================================\n&#39; ĐỊNH NGHĨA MỐI QUAN HỆ (RELATIONSHIPS)\n&#39; Ký hiệu: ||..o{ (1 - Nhiều, đường đứt nét)\n&#39; Ký hiệu: |o..o{ (0 hoặc 1 - Nhiều, đường đứt nét)\n&#39; ==========================================\n\nsc ||..o{ ps : \&quot;Chứa\&quot;\np ||..o{ ps : \&quot;Được lưu trữ\&quot;\n\nsc ||..o{ ptr : \&quot;Thực hiện\&quot;\np ||..o{ ptr : \&quot;Thuộc về\&quot;\nt |o..o{ ptr : \&quot;Gắn với (Tùy chọn cho Nhập)\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YTzS3zx1XN7zenvUBFFy-1">
